import QLean.Circuits.Foundation.ClassicalReversibleStage
import QLean.Circuits.Foundation.ControlledConstantAdderAnalytic

/-!
# Source-order controlled constant addition components

The strict component is valid on the full basis, including dirty addend and
carry wires.  The clean semantic refinement is proved separately.
-/

namespace VerifiedCircuitCore

noncomputable section

/-- Full-dirty Exact component of the Cuccaro register adder. -/
def cuccaroAddModExactOperatorComponent {qubits tailWidth : Nat}
    (symbolValue : String → ℝ)
    (spec : CuccaroAddModSpec qubits tailWidth) :
    ExactOperatorComponent
      (primitiveGateOperatorWithSymbols (qubits := qubits) symbolValue) :=
  (cuccaroAddModStage spec).primitiveExactOperatorComponent symbolValue

/-- Full-dirty Unitary Exact component of the Cuccaro register adder. -/
def cuccaroAddModUnitaryExactOperatorComponent {qubits tailWidth : Nat}
    (symbolValue : String → ℝ)
    (spec : CuccaroAddModSpec qubits tailWidth) :
    UnitaryExactOperatorComponent
      (primitiveGateOperatorWithSymbols (qubits := qubits) symbolValue) :=
  ExactOperatorComponent.toUnitary
    (primitiveGateOperatorWithSymbols_mem_unitaryGroup symbolValue)
    (cuccaroAddModExactOperatorComponent symbolValue spec)

/-- Full-dirty Exact component of the source-order controlled constant adder. -/
def controlledAddConstantMod2PowExactOperatorComponent
    {qubits tailWidth : Nat}
    (symbolValue : String → ℝ)
    (spec : ControlledAddConstantMod2PowSpec qubits tailWidth) :
    ExactOperatorComponent
      (primitiveGateOperatorWithSymbols (qubits := qubits) symbolValue) :=
  (controlledAddConstantMod2PowStage spec).primitiveExactOperatorComponent
    symbolValue

/-- Full-dirty Unitary Exact component of the source-order controlled constant
adder. -/
def controlledAddConstantMod2PowUnitaryExactOperatorComponent
    {qubits tailWidth : Nat}
    (symbolValue : String → ℝ)
    (spec : ControlledAddConstantMod2PowSpec qubits tailWidth) :
    UnitaryExactOperatorComponent
      (primitiveGateOperatorWithSymbols (qubits := qubits) symbolValue) :=
  ExactOperatorComponent.toUnitary
    (primitiveGateOperatorWithSymbols_mem_unitaryGroup symbolValue)
    (controlledAddConstantMod2PowExactOperatorComponent symbolValue spec)

/-- Public source-order AST transport for layout adapters. -/
theorem controlledAddConstantMod2PowExactOperatorComponent_circuit
    {qubits tailWidth : Nat}
    (symbolValue : String → ℝ)
    (spec : ControlledAddConstantMod2PowSpec qubits tailWidth) :
    (controlledAddConstantMod2PowExactOperatorComponent
        symbolValue spec).circuit =
      (controlledAddConstantMod2PowStage spec).compile := by
  exact ClassicalReversibleStage.primitiveExactOperatorComponent_circuit
    symbolValue (controlledAddConstantMod2PowStage spec)

/-- Public full-dirty target transport for layout adapters. -/
theorem controlledAddConstantMod2PowExactOperatorComponent_target
    {qubits tailWidth : Nat}
    (symbolValue : String → ℝ)
    (spec : ControlledAddConstantMod2PowSpec qubits tailWidth) :
    (controlledAddConstantMod2PowExactOperatorComponent
        symbolValue spec).target =
      controlledAddConstantMod2PowDirtyOperator spec := by
  exact ClassicalReversibleStage.primitiveExactOperatorComponent_target
    symbolValue (controlledAddConstantMod2PowStage spec)

/-- Clean masked-register semantic component of controlled constant addition.
The input and output spans are generated by basis states with zero masked
addend and carry work. -/
def controlledAddConstantMod2PowSubspaceMapComponent
    {qubits tailWidth : Nat}
    (symbolValue : String → ℝ)
    (spec : ControlledAddConstantMod2PowSpec qubits tailWidth) :
    SubspaceMapComponent
      (primitiveGateOperatorWithSymbols (qubits := qubits) symbolValue) :=
  SubspaceMapComponent.ofBasisSpan
    (primitiveGateOperatorWithSymbols symbolValue)
    (controlledAddConstantMod2PowExactOperatorComponent
      symbolValue spec).circuit
    (controlledAddConstantMod2PowSemanticOperator spec)
    (controlledAddConstantMod2PowCleanPredicate spec)
    (controlledAddConstantMod2PowCleanPredicate spec)
    (by
      intro input clean
      rw [(controlledAddConstantMod2PowExactOperatorComponent
        symbolValue spec).correct,
        controlledAddConstantMod2PowExactOperatorComponent_target]
      rw [controlledAddConstantMod2PowDirtyOperator,
        ClassicalReversibleStage.analyticOperator_eq_deterministicReference,
        applyOperator_deterministicOperator_basisKet,
        controlledAddConstantMod2PowStage_reference_apply_of_clean spec input clean,
        controlledAddConstantMod2PowSemanticOperator,
        applyOperator_deterministicOperator_basisKet])
    (by
      intro input clean
      rw [controlledAddConstantMod2PowSemanticOperator,
        applyOperator_deterministicOperator_basisKet]
      apply SubspaceMapComponent.basisKet_mem_basisSpan
      exact controlledAddConstantMod2PowBasisAction_clean spec input clean)

end

end VerifiedCircuitCore
