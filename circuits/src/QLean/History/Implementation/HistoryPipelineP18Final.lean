noncomputable section

abbrev ExecutableD119 (source : AlignedCommonSource119) : Nat :=
  Fintype.card (QConfiguration source.qParameters)

abbrev ExecutableC119 (source : AlignedCommonSource119) : Nat :=
  source.historyParameters.clockEnd

abbrev ExecutableR119 (source : AlignedCommonSource119) : Nat :=
  source.historyParameters.taylorOrder

abbrev ExecutableM119 (source : AlignedCommonSource119) : Nat :=
  source.historyParameters.physicalClocks

abbrev ExecutableLabels119 (source : AlignedCommonSource119) : Nat :=
  source.historyParameters.binaryLabels

/-- The mathematical history system generated by the same source that emits
the corrected executable P05 circuit. -/
def executableSystem119 (source : AlignedCommonSource119) :
    JenningsHistory.HistorySpec (ExecutableD119 source) (ExecutableC119 source)
      (ExecutableR119 source) (ExecutableM119 source)
      (ExecutableLabels119 source) :=
  ExecutableHistoryReferenceM10Bridge.translatedSystem
    source.historyParameters
    (commonModelQ119 source.toCommonSource119)
    source.initial source.historyWellFormed

def executableAlpha119 (source : AlignedCommonSource119) : ℝ :=
  correctedAlpha119 source.historyParameters.taylorOrder

/-- Scientific assumptions already required by the accepted M13/P18 layer.
No circuit target, operator, or entry equality is supplied here. -/
structure ExecutableM13Assumptions119 (source : AlignedCommonSource119) where
  nu : ℝ
  x : JenningsHistory.HistoryVector (ExecutableD119 source)
    (ExecutableC119 source) (ExecutableLabels119 source)
  hwell : JenningsHistory.wellPosed
    (GramOperator.enlargedMatrix (executableSystem119 source)
      (executableAlpha119 source) nu)
  hdet : IsUnit
    (Matrix.det (GramOperator.enlargedMatrix (executableSystem119 source)
      (executableAlpha119 source) nu))
  hraw : JenningsHistory.linearApply
      (JenningsHistory.historyMatrix (executableSystem119 source)) x =
    JenningsHistory.historyRhs (executableSystem119 source)
  hrhs : JenningsHistory.rhsNorm (executableSystem119 source) ≠ 0
  sourceInitial_nonzero : source.initial ≠ 0
  hAlpha : executableAlpha119 source ≠ 0
  hNu : nu ≠ 0
  hNuPos : 0 < nu
  hAlphaPos : 0 < executableAlpha119 source
  hb : JenningsHistory.unitNorm (GramOperator.bPlus (executableSystem119 source))
  hXPos : 0 < JenningsHistory.unitNormSquared
    (ConcreteHistoryInput.m13XAlpha (executableSystem119 source)
      (executableAlpha119 source) x)
  historyInverseNorm : ℝ
  historyInverseNorm_nonneg : 0 ≤ historyInverseNorm
  historyInverseBound : ∀ z : JenningsHistory.HistoryVector
      (ExecutableD119 source) (ExecutableC119 source)
      (ExecutableLabels119 source),
    Real.sqrt (JenningsHistory.unitNormSquared
      (((JenningsHistory.scaledHistory (executableSystem119 source)
        (executableAlpha119 source))⁻¹).mulVec z)) ≤
      historyInverseNorm * Real.sqrt (JenningsHistory.unitNormSquared z)
  one_le_nu : 1 ≤ nu
  nu_le_xNorm : nu ≤ Real.sqrt (JenningsHistory.unitNormSquared
    (ConcreteHistoryInput.m13XAlpha (executableSystem119 source)
      (executableAlpha119 source) x))
  xNorm_le_historyInverseNorm : Real.sqrt (JenningsHistory.unitNormSquared
      (ConcreteHistoryInput.m13XAlpha (executableSystem119 source)
        (executableAlpha119 source) x)) ≤ historyInverseNorm
  nu_le_historyInverseNorm : nu ≤ historyInverseNorm
  historyContraction : ∀ z : JenningsHistory.HistoryVector
      (ExecutableD119 source) (ExecutableC119 source)
      (ExecutableLabels119 source),
    JenningsHistory.unitNormSquared
      ((JenningsHistory.scaledHistory (executableSystem119 source)
        (executableAlpha119 source)).mulVec z) ≤
      JenningsHistory.unitNormSquared z
  kappaH : ℝ
  kappaH_pos : 0 < kappaH
  historyInverseNorm_le_kappaH : historyInverseNorm ≤ kappaH

def executableM13Base119
    (source : AlignedCommonSource119)
    (assumptions : ExecutableM13Assumptions119 source) :
    TypedNegativeCases.M13Admissible (ExecutableD119 source) (ExecutableC119 source)
      (ExecutableR119 source) (ExecutableM119 source)
      (ExecutableLabels119 source) where
  system := executableSystem119 source
  alpha := executableAlpha119 source
  nu := assumptions.nu
  x := assumptions.x
  hwell := assumptions.hwell
  hdet := assumptions.hdet
  hraw := assumptions.hraw
  hrhs := assumptions.hrhs
  hα := assumptions.hAlpha
  hν := assumptions.hNu
  hνpos := assumptions.hNuPos
  hαpos := assumptions.hAlphaPos
  hb := assumptions.hb
  hXpos := assumptions.hXPos

def executableP18Input119
    (source : AlignedCommonSource119)
    (assumptions : ExecutableM13Assumptions119 source) :
    DalzellDilation.CertifiedM13Input (ExecutableD119 source) (ExecutableC119 source)
      (ExecutableR119 source) (ExecutableM119 source)
      (ExecutableLabels119 source) where
  base := executableM13Base119 source assumptions
  historyInverseNorm := assumptions.historyInverseNorm
  historyInverseNorm_nonneg := assumptions.historyInverseNorm_nonneg
  historyInverseBound := assumptions.historyInverseBound
  one_le_nu := assumptions.one_le_nu
  nu_le_xNorm := assumptions.nu_le_xNorm
  xNorm_le_historyInverseNorm := assumptions.xNorm_le_historyInverseNorm
  nu_le_historyInverseNorm := assumptions.nu_le_historyInverseNorm
  historyContraction := assumptions.historyContraction
  kappaH := assumptions.kappaH
  kappaH_pos := assumptions.kappaH_pos
  historyInverseNorm_le_kappaH := assumptions.historyInverseNorm_le_kappaH

/-- Exact layout data for placing the corrected P05 circuit inside the
accepted H-nu extension.  This carries wiring only, never semantic equality. -/
structure ExecutableP18CircuitSource119
    (source : AlignedCommonSource119)
    (domain : ExecutableHistoryDomain119 source)
    (fits : HistoryIndexFitsLayout119 source)
    (assumptions : ExecutableM13Assumptions119 source) where
  targetQubits : Nat
  layout : ControlLayout (ExecutableRaw119 source).history.qubits
    targetQubits

def executableP18HistoryEmbedding119
    (source : AlignedCommonSource119)
    (domain : ExecutableHistoryDomain119 source)
    (fits : HistoryIndexFitsLayout119 source) :
    JenningsHistory.HistoryIndex (ExecutableD119 source) (ExecutableC119 source)
      (ExecutableLabels119 source) ↪
      QubitBasis (ExecutableRaw119 source).history.qubits where
  toFun := fun index =>
    executableHistoryBasis119 source domain fits
      ((ExecutableHistoryReferenceM10Bridge.indexEquiv
        source.historyParameters).symm index)
  inj' := by
    intro left right equal
    apply (ExecutableHistoryReferenceM10Bridge.indexEquiv
      source.historyParameters).symm.injective
    exact executableHistoryBasis119_injective source domain fits equal

theorem correctedP05Circuit119_isNormalized
    (source : AlignedCommonSource119)
    (domain : ExecutableHistoryDomain119 source) :
    IsNormalizedCircuit (correctedP05Component119 source domain).circuit := by
  intro gate member
  cases gate <;>
    simp [ControlledCircuitCompilerV2.IsNormalizedPrimitive]

/-- The single concrete H-history child demanded by F003.  Its clean-block
field is derived from sequence 4, so the P18 facade has no semantic rebind
premise. -/
def executableInternalHHistory119
    (source : AlignedCommonSource119)
    (domain : ExecutableHistoryDomain119 source)
    (fits : HistoryIndexFitsLayout119 source)
    (assumptions : ExecutableM13Assumptions119 source)
    (circuitSource : ExecutableP18CircuitSource119
      source domain fits assumptions) :
    InternalHHistoryCleanComponentF
      (executableP18Input119 source assumptions)
      circuitSource.targetQubits where
  sourceQubits := (ExecutableRaw119 source).history.qubits
  layout := circuitSource.layout
  circuit :=
    { circuit := (correctedP05Component119 source domain).circuit
      normalized := correctedP05Circuit119_isNormalized source domain }
  embedding := executableP18HistoryEmbedding119 source domain fits
  inrBasis := zeroBasis119 (ExecutableRaw119 source).history.qubits
  clean_block := by
    intro row col
    let oldRow := (ExecutableHistoryReferenceM10Bridge.indexEquiv
      source.historyParameters).symm row
    let oldCol := (ExecutableHistoryReferenceM10Bridge.indexEquiv
      source.historyParameters).symm col
    change Circuit.denote (primitiveGateOperatorWithSymbols (fun _ => 0))
        (correctedP05Component119 source domain).circuit
        (executableHistoryBasis119 source domain fits oldRow)
        (executableHistoryBasis119 source domain fits oldCol) =
      (JenningsHistory.scaledHistory (executableSystem119 source)
        (executableAlpha119 source) row col : ℂ)
    rw [show (fun _ : String => (0 : ℝ)) = internalZeroSymbolEnvironment by rfl]
    simpa [oldRow, oldCol, executableSystem119, executableAlpha119] using
      correctedP05Component119_entry_eq_scaledHistory
        source domain fits oldRow oldCol

end

end ExecutableHistoryExecutableP18
